# ============================================================================
# metrics-collector configuration. Copy to .env (or export the variables).
# Any metric whose required vars are missing is skipped. `npm run check` shows what's runnable.
# ============================================================================

# ---- Run ------------------------------------------------------------------
REPORT_FROM=2026-08-01               # inclusive, YYYY-MM-DD (default: 90 days ending yesterday)
REPORT_TO=2026-10-31                 # inclusive
TZ=Asia/Singapore                    # time zone used for the window boundaries
METRICS=all                          # or comma list: cycle_time,lead_time,mttr,...  (npm run list)
OUTPUT_DIR=output
LOG_LEVEL=info                       # debug prints every URL/JQL
HTTP_CONCURRENCY=5
# JIRA_EXACT_COUNTS=false           # true = count by paging keys instead of Jira's approximate-count (slower, exact)
# PROGRESS_INTERVAL_MS=5000          # how often long Jira loops log progress (0 = every batch); short jobs stay silent
# NODE_EXTRA_CA_CERTS=/path/corp-root-ca.pem   # corporate TLS inspection / internal CAs
# NODE_TLS_REJECT_UNAUTHORIZED=0     # last resort: disables ALL certificate checks (see README, "TLS-inspecting proxies")
# HTTPS_PROXY=http://proxy:8080      # also HTTP_PROXY; honours NO_PROXY=ssc.internal,... (uses undici; run `npm install`)

# ---- Jira Cloud + Confluence Cloud (same site & token) --------------------
JIRA_BASE_URL=https://yourco.atlassian.net
JIRA_EMAIL=you@yourco.com
JIRA_API_TOKEN=                      # https://id.atlassian.com/manage-profile/security/api-tokens ("Create API token with scopes")
# ATLASSIAN_TOKEN_TYPE=scoped        # default. scoped (via api.atlassian.com gateway) | classic (site URL)
# ATLASSIAN_CLOUD_ID=                # optional; otherwise looked up from JIRA_BASE_URL/_edge/tenant_info
JIRA_SCOPE_JQL=project in (ABC, DEF)               # which teams/projects - any JQL
# JIRA_WORK_ITEM_JQL=issuetype in (Story, Task, Bug) # optional extra filter for cycle/lead time
JIRA_START_STATUSES=In Progress                     # comma list
JIRA_DONE_STATUSES=Done,Closed
JIRA_DEFECT_TYPES=Bug
JIRA_STORY_TYPES=Story
# Defect escape: JQL identifying UAT/Prod defects (pick ONE convention and agree it with teams)
JIRA_ESCAPED_DEFECT_JQL='"Found In[Dropdown]" in (UAT, Production)'   # single-quote values that start with "
#   e.g. labels in (uat-defect, prod-defect)
# Regression: JQL identifying regression defects
JIRA_REGRESSION_JQL=labels = regression
JIRA_REGRESSION_GROUP_BY=affectedVersion            # or fixVersion
# CONFLUENCE_BASE_URL=https://yourco.atlassian.net/wiki   # default: JIRA_BASE_URL/wiki

# ---- Lead Time for Change -------------------------------------------------
LEAD_TIME_MODE=bamboo                # bamboo (deploy timestamps) | fixversion (release date proxy)
LEAD_TIME_START=created              # or status:Selected for Development|Approved
LEAD_TIME_LOOKBACK_DAYS=365          # fixversion mode only

# ---- Bamboo ----------------------------------------------------------------
BAMBOO_URL=https://bamboo.yourco.internal
BAMBOO_TOKEN=                        # personal access token (or BAMBOO_USER + BAMBOO_PASSWORD)
BAMBOO_DEPLOY_PROJECTS=              # deployment project names or ids; empty = all
BAMBOO_PROD_ENVIRONMENTS=Production,PROD
BAMBOO_INCLUDE_INTERMEDIATE_BUILDS=true
# BAMBOO_JIRA_KEY_PREFIXES=ABC,DEF   # only accept these project keys from commit messages

# ---- SonarQube ------------------------------------------------------------
SONAR_URL=https://sonar.yourco.internal
SONAR_TOKEN=
SONAR_PROJECT_KEYS=                  # comma list; or SONAR_PROJECT_SEARCH=substring; empty = all
# SONAR_BRANCH=main

# ---- Fortify SSC ----------------------------------------------------------
FORTIFY_URL=https://ssc.yourco.internal/ssc
FORTIFY_TOKEN=                       # encoded token (e.g. AnalysisDownloadToken / UnifiedLoginToken)
FORTIFY_APPLICATIONS=                # "App" or "App:Version" comma list; or FORTIFY_VERSION_IDS; empty = all
FORTIFY_PRIORITIES=Critical,High

# ---- Nexus IQ ---------------------------------------------------------------
NEXUSIQ_URL=https://iq.yourco.internal
NEXUSIQ_USER=                        # user-token code
NEXUSIQ_TOKEN=                       # user-token passcode
NEXUSIQ_APPLICATIONS=                # public ids; or NEXUSIQ_ORGANIZATIONS=names/ids; empty = all
NEXUSIQ_THREAT_LEVELS=CRITICAL,SEVERE         # for "vulnerable components introduced"
# NEXUSIQ_POLICY_THREAT_LEVELS=               # empty = all levels for policy violations

# ---- ServiceNow -------------------------------------------------------------
SNOW_URL=https://yourco.service-now.com
SNOW_USER=
SNOW_PASSWORD=                       # or SNOW_TOKEN (OAuth bearer)
SNOW_CHANGE_QUERY=assignment_group.nameINApp Team A,App Team B   # encoded query - scope changes
SNOW_FAILED_CLOSE_CODES=unsuccessful
SNOW_CFR_USE_CAUSED_INCIDENTS=true
SNOW_INCIDENT_CAUSED_BY_FIELD=caused_by
SNOW_INCIDENT_QUERY=priority<=2^assignment_group.nameINApp Team A,App Team B
SNOW_INCIDENT_START_FIELD=opened_at
SNOW_INCIDENT_END_FIELD=resolved_at  # or a custom "service restored" field e.g. u_restored_at

# ---- Dynatrace (optional second MTTR view) -----------------------------------
DT_URL=https://abc12345.live.dynatrace.com
DT_API_TOKEN=                        # scope: problems.read
# DT_PROBLEM_SELECTOR=managementZones("App A")
# DT_SEVERITY_LEVELS=AVAILABILITY,ERROR

# ---- QMetry (QTM4J Cloud) - endpoint unverified -------------------------------
QMETRY_BASE_URL=https://qtmcloud.qmetry.com/rest/api/latest
QMETRY_API_KEY=
QMETRY_PROJECT_ID=

# ---- Gen-e2 / Requirements --------------------------------------------------
PRD_SOURCE=epic                      # epic (markdown PRD attached to Jira epics) | confluence | jpd
# PRD_EPIC_JQL=issuetype = Epic        # which epics can hold a PRD (ANDed with JIRA_SCOPE_JQL)
# PRD_ATTACHMENT_PATTERN=prd.*\.md$    # regex on the attachment file name (default \.md$ = any markdown file)
# PRD_APPROVED_AT=attachment           # start of PRD-to-story: first upload, or status:Approved|Ready on the epic
# CONFLUENCE_PRD_CQL=space in ("PROD") AND label = "prd"        # only for PRD_SOURCE=confluence
GENE2_CONFLUENCE_LABEL=aisdlc
GENE2_JIRA_JQL=labels = "aisdlc"
# JPD_IDEAS_JQL=project = IDEAS
# JPD_APPROVED_STATUSES=Ready for delivery
# JPD_DELIVERY_LINK_TYPES=Polaris work item link
STORY_READY_AT=created               # or status:Ready for Dev
PRD_STORY_LOOKAHEAD_DAYS=120
GENE2_ACCEPT_THRESHOLD=0.8
